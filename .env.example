# Параметры подключения к коммутатору Juniper (QFX / EX)
JUNIPER_HOST=10.10.100.200
JUNIPER_PORT=22
JUNIPER_USER=admin

# Аутентификация по SSH-ключу:
JUNIPER_USE_KEYS=True
JUNIPER_KEY_FILE=/home/user/.ssh/id_rsa

# Аутентификация по паролю (раскомментируйте при необходимости):
# JUNIPER_PASSWORD=your_password_here
